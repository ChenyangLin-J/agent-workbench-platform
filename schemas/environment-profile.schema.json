{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workbench.local/schemas/environment-profile.schema.json",
  "title": "Agent Workbench Environment Profile",
  "type": "object",
  "required": ["id"],
  "properties": {
    "$schema": { "const": "agent-workbench.environment-profile/v1" },
    "schema": { "const": "agent-workbench.environment-profile/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "title": { "type": "string", "minLength": 1 },
    "runtime": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "modelGateway": { "$ref": "#/$defs/modelGateway" }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "sessionWorkspace": { "const": true },
        "attachments": { "type": "boolean" },
        "sideChat": { "type": "boolean" },
        "subagents": { "type": "boolean" },
        "browser": { "type": "boolean" },
        "capabilityMutation": { "type": "boolean" },
        "evidenceDashboard": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "lock": { "$ref": "#/$defs/capabilityLock" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/openMetadataReadAdapter" },
              { "$ref": "#/$defs/bigQueryReadAdapter" },
              { "$ref": "#/$defs/moduleMcpReadAdapter" }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "minimumLevel": { "enum": ["development", "guarded-host", "ephemeral-machine"] },
        "filesystem": {
          "type": "object",
          "properties": {
            "readableRoots": { "$ref": "#/$defs/stringList" },
            "writableRoots": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "environmentKeys": { "$ref": "#/$defs/stringList" },
        "networkTargets": { "$ref": "#/$defs/stringList" },
        "credentialReferences": { "$ref": "#/$defs/stringList" },
        "externalEffects": {
          "type": "object",
          "properties": {
            "read": { "$ref": "#/$defs/stringList" },
            "write": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "modelGateway": {
      "type": "object",
      "required": ["type", "baseUrl", "credentialReference"],
      "properties": {
        "type": { "const": "openai-compatible-responses" },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^/?#]+(?:/[^?#]*)?$"
        },
        "credentialReference": {
          "type": "string",
          "pattern": "^credentials\\.[a-z0-9][a-z0-9.-]{0,126}$"
        }
      },
      "additionalProperties": false
    },
    "capabilityLock": {
      "type": "object",
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "catalogVersion": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "scope", "version"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "openMetadataReadAdapter": {
      "type": "object",
      "required": ["id", "kind", "server", "target", "credentialReference", "effect", "allowedTools"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "openmetadata-mcp-read" },
        "server": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
        "target": { "type": "string", "format": "uri" },
        "credentialReference": { "type": "string", "pattern": "^credentials\\.[a-z0-9][a-z0-9.-]{0,126}$" },
        "effect": { "const": "metadata.read" },
        "allowedTools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["search_metadata", "get_entity_details", "get_entity_lineage"] }
        }
      },
      "additionalProperties": false
    },
    "bigQueryReadAdapter": {
      "type": "object",
      "required": ["id", "kind", "server", "credentialReference", "effect", "billingProject", "allowedProjects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "bigquery-read" },
        "server": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
        "credentialReference": { "type": "string", "pattern": "^credentials\\.[a-z0-9][a-z0-9.-]{0,126}$" },
        "effect": { "const": "warehouse.read" },
        "billingProject": { "type": "string", "minLength": 6 },
        "allowedProjects": { "$ref": "#/$defs/stringList" },
        "maximumBytesBilled": { "type": "integer", "minimum": 1 },
        "maximumRows": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "moduleMcpReadAdapter": {
      "type": "object",
      "required": ["id", "kind", "server", "entrypoint", "credentialEnvironment", "networkTargets", "effect", "allowedTools"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "module-mcp-read" },
        "server": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
        "entrypoint": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+\\.(?:mjs|js)$" },
        "credentialEnvironment": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{1,126}$" },
          "additionalProperties": { "type": "string", "pattern": "^credentials\\.[a-z0-9][a-z0-9.-]{0,126}$" }
        },
        "networkTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "effect": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,126}\\.read$" },
        "allowedTools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" }
        }
      },
      "additionalProperties": false
    }
  }
}
